# Copy this file to .env and fill in your keys. Never commit .env.
OPENAI_API_KEY=your-key-here
# The UO OpenAI Portal endpoint, if they gave you one (leave blank for OpenAI directly)
OPENAI_BASE_URL=https://app-uoaihack2ix6ak.azurewebsites.net
MODEL_NAME=gpt-6.1-sol
QUICK_MODEL_NAME=gpt-6-luna
# The chat box uses GPT-6 Astra
CHAT_MODEL_NAME=gpt-6-astra
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=cf7ef764a72120ee4e014e4aae809ae9
# Free key from https://finnhub.io/register (analyst ratings + news)
FINNHUB_API_KEY=dbdl33pr01qtak1r0ia0dbdl33pr01qtak1r0iag
# SEC asks for a name and email in every request
SEC_USER_AGENT=Heirloom Hackathon yourname@example.com

# Where the Buy/Sell buttons go. Use {ticker} where the fund code belongs.
BROKER_NAME=Yahoo Finance
BROKER_URL_TEMPLATE=https://finance.yahoo.com/quote/{ticker}

# Email for weekly updates and alerts (Gmail: use an App password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
